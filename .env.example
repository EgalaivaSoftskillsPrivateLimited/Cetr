# Public origin used in verification QR codes and by the PDF renderer.
# In the browser, the current origin is used automatically.
# On the server (email/PDF), this must be reachable from the Node process.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP — certificates still issue if these are missing; email is skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Admin login (/admin) — used to generate one-time certificate claim links.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs the admin session cookie. If unset, a random secret is generated at
# process start and all admins are signed out on every restart/deploy — set
# this for persistent sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
